      <column caption='key' datatype='integer' name='[Calculation_238409371417276418]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if isnull([加盟店法人名]) then 0 else 1 end' />
      </column>
      <column aggregation='Sum' caption='キャンセル_撤去_flag' datatype='integer' name='[Calculation_238409371417354243]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if NOT ISNULL([キャンセル日]) then 1&#13;&#10;elseif NOT ISNULL([撤去日]) then 1&#13;&#10;else 0 end' />
      </column>
      <column caption='集計対象月' datatype='date' name='[Calculation_238409371417587717]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='date(left([年月],4)+&quot;-&quot;+right([年月],2)+&quot;-01&quot;)' />
      </column>
      <column aggregation='Sum' caption='選択した年月_売上' datatype='integer' name='[Calculation_238409371417640966]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Calculation_238409371417587717] = DATE(DATETRUNC(&apos;month&apos;,[売上日])) then 1 else 0 end' />
      </column>
      <column aggregation='Sum' caption='選択した年月_年月' datatype='integer' name='[Calculation_238409371418009607]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Calculation_238409371417587717] = DATETRUNC(&apos;month&apos;, DATEPARSE(&apos;yyyyMM&apos;, [年月])) THEN 1 ELSE 0 END' />
      </column>
      <column caption='年月_稼働日' datatype='string' name='[Calculation_238409371418284040]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='str(year([本日])) +&#13;&#10;right((&apos;00&apos; + str(month([本日]))),2)' />
      </column>
      <column caption='♯稼働日' datatype='real' name='[Calculation_238409371418357769]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED  [年月] : max(if [年月] = [Calculation_238409371418284040] then [稼働日]&#13;&#10;else [営業日日数] end) }' />
      </column>
      <column caption='タグ01_name' datatype='string' name='[Calculation_238409371418611722]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if FIRST() = 0 then min([タグ01])&#13;&#10;else PREVIOUS_VALUE(min([タグ01]))+&quot;,&quot;+min([タグ01])&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='タグ01_rank' datatype='integer' name='[Calculation_238409371418669067]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='rank([Calculation_238409371418611722])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='タグ02_name' datatype='string' name='[Calculation_238409371418714124]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if INDEX() = 1 then min([タグ02])&#13;&#10;else PREVIOUS_VALUE(min([タグ02]))+&quot;,&quot;+min([タグ02])&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='タグ02_rank' datatype='integer' name='[Calculation_238409371418763277]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='rank([Calculation_238409371418714124])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='タグ03_name' datatype='string' name='[Calculation_238409371418800142]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if INDEX() = 1 then min([タグ03])&#13;&#10;else PREVIOUS_VALUE(min([タグ03]))+&quot;,&quot;+min([タグ03])&#13;&#10;end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='タグ03_rank' datatype='integer' name='[Calculation_238409371418857487]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='rank([Calculation_238409371418800142])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='#稼働率' datatype='real' name='[Calculation_238409371419234320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_238409371418357769]) / sum([営業日日数])' />
      </column>
      <column caption='件数_OK' datatype='integer' name='[Calculation_238409371419353105]' role='measure' type='quantitative'>
