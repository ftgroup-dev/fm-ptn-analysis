  <worksheets>
    <worksheet name='OK①'>
      <table>
        <view>
          <datasources>
            <datasource caption='再構築_実績集計テーブル' name='sqlproxy.09o271k04fehgu1f1fiss1lglpn0' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.09o271k04fehgu1f1fiss1lglpn0'>
            <column caption='key' datatype='integer' name='[Calculation_238409371417276418]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if isnull([加盟店法人名]) then 0 else 1 end' />
            </column>
            <column aggregation='Sum' caption='キャンセル_撤去_flag' datatype='integer' name='[Calculation_238409371417354243]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if NOT ISNULL([キャンセル日]) then 1&#13;&#10;elseif NOT ISNULL([撤去日]) then 1&#13;&#10;else 0 end' />
            </column>
            <column caption='集計対象月' datatype='date' name='[Calculation_238409371417587717]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(left([年月],4)+&quot;-&quot;+right([年月],2)+&quot;-01&quot;)' />
            </column>
            <column aggregation='Sum' caption='選択した年月_年月' datatype='integer' name='[Calculation_238409371418009607]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_238409371417587717] = DATETRUNC(&apos;month&apos;, DATEPARSE(&apos;yyyyMM&apos;, [年月])) THEN 1 ELSE 0 END' />
            </column>
            <column caption='年月_稼働日' datatype='string' name='[Calculation_238409371418284040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(year([本日])) +&#13;&#10;right((&apos;00&apos; + str(month([本日]))),2)' />
            </column>
            <column caption='♯稼働日' datatype='real' name='[Calculation_238409371418357769]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED  [年月] : max(if [年月] = [Calculation_238409371418284040] then [稼働日]&#13;&#10;else [営業日日数] end) }' />
            </column>
            <column caption='件数_OK' datatype='integer' name='[Calculation_238409371419353105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [OK実績] &gt;= 0 and [Calculation_238409371418009607] = 1 and [Calculation_238409371417354243] = 0 then [主キー] else null end)' />
            </column>
            <column caption='実績_OK' datatype='real' name='[Calculation_238409371419439123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;    if [Calculation_238409371418009607] = 1&#13;&#10;       and NOT ISNULL([OK日]) &#13;&#10;       and [Calculation_238409371417354243] = 0 &#13;&#10;    then [OK実績]&#13;&#10;    else 0 &#13;&#10;    end&#13;&#10;)&#13;&#10;/1000' />
            </column>
            <column caption='目標_OK' datatype='real' name='[Calculation_238409371419562006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM([OK目標]),0)' />
            </column>
            <column caption='残数_OK' datatype='real' name='[Calculation_238409371419639832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_238409371419562006] &gt;0 then [Calculation_238409371419562006] - [Calculation_238409371419439123]&#13;&#10;else 0 end' />
            </column>
            <column caption='進捗率_OK' datatype='real' default-format='p0%' name='[Calculation_238409371419729946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(&#13;&#10;    ([Calculation_238409371419439123] / sum([Calculation_238409371418357769]))&#13;&#10;    /&#13;&#10;    ([Calculation_238409371419562006] / sum([営業日日数]))&#13;&#10;)' />
            </column>
            <column caption='進捗率カラーレベル_OK' datatype='string' name='[Calculation_238409371419807772]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_238409371419729946] &lt; 0.8 then &apos;未達&apos;&#13;&#10;elseif [Calculation_238409371419729946] &lt; 1 then &apos;80%以上&apos;&#13;&#10;else &apos;達成&apos; end' />
            </column>
            <column caption='達成率_OK' datatype='real' default-format='p0%' name='[Calculation_238409371419901982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(&#13;&#10;if [Calculation_238409371419562006] &gt; 0 then [Calculation_238409371419439123] / [Calculation_238409371419562006]&#13;&#10;else 0 end&#13;&#10;)' />
            </column>
            <column caption='達成率バー' datatype='real' name='[Calculation_238409371420205088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='min(1.2)' />
            </column>
            <column caption='&quot;全体集計&quot;' datatype='string' name='[Calculation_238409371421872165]' role='dimension' type='nominal' user:unnamed='シート 1'>
              <calculation class='tableau' formula='&quot;全体集計&quot;' />
            </column>
            <column caption='&apos;表示&apos;' datatype='string' name='[Calculation_556757570444042252]' role='dimension' type='nominal' user:unnamed='OK①'>
              <calculation class='tableau' formula='&apos;表示&apos;' />
