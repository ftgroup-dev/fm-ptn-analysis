    <worksheet name='売上①'>
      <table>
        <view>
          <datasources>
            <datasource caption='再構築_実績集計テーブル' name='sqlproxy.09o271k04fehgu1f1fiss1lglpn0' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.09o271k04fehgu1f1fiss1lglpn0'>
            <column caption='key' datatype='integer' name='[Calculation_238409371417276418]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if isnull([加盟店法人名]) then 0 else 1 end' />
            </column>
            <column aggregation='Sum' caption='キャンセル_撤去_flag' datatype='integer' name='[Calculation_238409371417354243]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if NOT ISNULL([キャンセル日]) then 1&#13;&#10;elseif NOT ISNULL([撤去日]) then 1&#13;&#10;else 0 end' />
            </column>
            <column caption='集計対象月' datatype='date' name='[Calculation_238409371417587717]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(left([年月],4)+&quot;-&quot;+right([年月],2)+&quot;-01&quot;)' />
            </column>
            <column aggregation='Sum' caption='選択した年月_売上' datatype='integer' name='[Calculation_238409371417640966]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Calculation_238409371417587717] = DATE(DATETRUNC(&apos;month&apos;,[売上日])) then 1 else 0 end' />
            </column>
            <column caption='年月_稼働日' datatype='string' name='[Calculation_238409371418284040]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='str(year([本日])) +&#13;&#10;right((&apos;00&apos; + str(month([本日]))),2)' />
            </column>
            <column caption='♯稼働日' datatype='real' name='[Calculation_238409371418357769]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED  [年月] : max(if [年月] = [Calculation_238409371418284040] then [稼働日]&#13;&#10;else [営業日日数] end) }' />
            </column>
            <column caption='件数_売上' datatype='integer' name='[Calculation_238409371419402258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [売上実績] &gt;= 0 and [Calculation_238409371417640966] = 1 and [Calculation_238409371417354243] = 0  then [主キー] else null end)' />
            </column>
            <column caption='実績_売上' datatype='real' name='[Calculation_238409371419475988]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Calculation_238409371417640966] = 1 and [Calculation_238409371417354243] = 0 then [売上実績] else 0 end)&#13;&#10;/1000' />
            </column>
            <column caption='目標_売上' datatype='real' name='[Calculation_238409371419602967]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM([売上目標]),0)' />
            </column>
            <column caption='残数_売上' datatype='real' name='[Calculation_238409371419680793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Calculation_238409371419602967] &gt;0 then [Calculation_238409371419602967] - [Calculation_238409371419475988]&#13;&#10;else 0 end' />
            </column>
            <column caption='進捗率_売上' datatype='real' default-format='p0%' name='[Calculation_238409371419766811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(&#13;&#10;    ([Calculation_238409371419475988] / sum([Calculation_238409371418357769])) &#13;&#10;    /&#13;&#10;    ([Calculation_238409371419602967] / sum([営業日日数]))&#13;&#10;)' />
            </column>
            <column caption='進捗率カラーレベル_売上' datatype='string' name='[Calculation_238409371419852829]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [Calculation_238409371419766811] &lt; 0.8 then &apos;未達&apos;&#13;&#10;elseif [Calculation_238409371419766811] &lt; 1 then &apos;80%以上&apos;&#13;&#10;else &apos;達成&apos; end' />
            </column>
            <column caption='達成率_売上' datatype='real' default-format='p0%' name='[Calculation_238409371420168223]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(&#13;&#10;    if [Calculation_238409371419602967] &gt; 0 then [Calculation_238409371419475988] / [Calculation_238409371419602967]&#13;&#10;    else 0 end&#13;&#10;    )' />
            </column>
            <column caption='達成率バー' datatype='real' name='[Calculation_238409371420205088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='min(1.2)' />
            </column>
            <column caption='&quot;全体集計&quot;' datatype='string' name='[Calculation_238409371421872165]' role='dimension' type='nominal' user:unnamed='シート 1'>
              <calculation class='tableau' formula='&quot;全体集計&quot;' />
