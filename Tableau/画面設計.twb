            <column caption='件数_売上' datatype='integer' name='[件数_OK (コピー)_676384412771287041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [売上実績] &gt;= 0 and [Calculation_807551733271777280] = 1 and [Calculation_770115577802661889] = 0  then [主キー] else null end)' />
            </column>
            <column aggregation='Sum' datatype='real' default-type='ordinal' layered='true' name='[営業日日数]' pivot='key' role='measure' type='ordinal' user-datatype='real' visual-totals='Default' />
