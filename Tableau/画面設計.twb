    <worksheet name='売上②'>
      <repository-location derived-from='https://prod-apnortheast-a.online.tableau.com/t/supportas/workbooks/_17341821672040/_12?rev=' id='16683712' path='/t/supportas/workbooks/_17341821672040' revision='' site='supportas' />
      <table>
        <view>
          <datasources>
            <datasource caption='実績集計テーブル' name='sqlproxy.0yym43i15hy5lu13mg7ex15c05lg' />
            <datasource caption='パラメーター' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='表示用' datatype='string' datatype-customized='true' name='[パラメーター 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;非表示&quot;'>
              <calculation class='tableau' formula='&quot;非表示&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='sqlproxy.0yym43i15hy5lu13mg7ex15c05lg'>
            <column caption='達成率バー' datatype='real' name='[Calculation_124623073162207232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='min(1.2)' />
            </column>
            <column aggregation='Sum' caption='♯稼働日' datatype='real' default-type='ordinal' layered='true' name='[Calculation_164381429429039109]' pivot='key' role='measure' type='ordinal' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='{ FIXED  [年月] : max(if [年月] = [Calculation_164381429429248006] then [稼働日]&#13;&#10;else [営業日日数] end) }' />
            </column>
            <column aggregation='Count' caption='年月_稼働日' datatype='string' default-type='nominal' layered='true' name='[Calculation_164381429429248006]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='str(year([本日])) +&#13;&#10;right((&apos;00&apos; + str(month([本日]))),2)' />
            </column>
            <column caption='表示' datatype='boolean' name='[Calculation_626563339817787392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[パラメーター 1] = &apos;表示&apos; then TRUE&#13;&#10;elseif [Parameters].[パラメーター 1] = &apos;表示_詳細&apos; then TRUE&#13;&#10;else FALSE end' />
            </column>
            <column caption='&apos;表示_詳細&apos;' datatype='string' name='[Calculation_626563339822456845]' role='dimension' type='nominal' user:unnamed='売上②'>
              <calculation class='tableau' formula='&apos;表示_詳細&apos;' />
            </column>
            <column aggregation='Sum' caption='key' datatype='integer' name='[Calculation_6805431644322123776]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if isnull([委託取次店法人名]) then 0 else 1 end' />
            </column>
            <column caption='集計対象月' datatype='date' default-format='*yyyy/mm' name='[Calculation_6894377737339797504]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(left([年月],4)+&quot;-&quot;+right([年月],2)+&quot;-01&quot;)' />
            </column>
            <column caption='キャンセル_撤去_flag' datatype='integer' name='[Calculation_770115577802661889]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if NOT ISNULL([キャンセル日]) then 1&#13;&#10;elseif NOT ISNULL([撤去日]) then 1&#13;&#10;else 0 end' />
            </column>
            <column aggregation='Sum' caption='選択した年月_売上' datatype='integer' name='[Calculation_807551733271777280]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Calculation_6894377737339797504] = DATE(DATETRUNC(&apos;month&apos;,[売上日])) then 1 else 0 end' />
            </column>
            <column caption='実績_売上' datatype='real' name='[Calculation_807551733274271746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(if [Calculation_807551733271777280] = 1 and [Calculation_770115577802661889] = 0 then [売上実績] else 0 end)&#13;&#10;/1000' />
            </column>
            <column caption='進捗率_売上' datatype='real' default-format='p0%' name='[Calculation_807551733275500548]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(&#13;&#10;    ([Calculation_807551733274271746] / sum([Calculation_164381429429039109])) &#13;&#10;    /&#13;&#10;    ([Calculation_807551733279838214] / sum([営業日日数]))&#13;&#10;)' />
            </column>
            <column caption='達成率_売上' datatype='real' default-format='p0%' name='[Calculation_807551733275873285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(&#13;&#10;    if [Calculation_807551733279838214] &gt; 0 then [Calculation_807551733274271746] / [Calculation_807551733279838214]&#13;&#10;    else 0 end&#13;&#10;    )' />
            </column>
            <column caption='目標_売上' datatype='real' name='[Calculation_807551733279838214]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM([売上目標]),0)' />
            </column>
            <column-instance column='[Calculation_6894377737339797504]' derivation='MY' name='[my:Calculation_6894377737339797504:ok]' pivot='key' type='ordinal' />
