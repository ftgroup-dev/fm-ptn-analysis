      <column caption='残数_売上' datatype='real' name='[実績 (コピー)_807551733274763267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Calculation_807551733279838214] &gt;0 then [Calculation_807551733279838214] - [Calculation_807551733274271746]&#13;&#10;else 0 end' />
      </column>
      <column caption='実績_OK' datatype='real' name='[実績_売上 (コピー)_6805431644325277702]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#13;&#10;    if [選択した年月_OK (コピー)_888616550506205184] = 1&#13;&#10;       and NOT ISNULL([OK日]) &#13;&#10;       and [Calculation_770115577802661889] = 0 &#13;&#10;    then [OK実績]&#13;&#10;    else 0 &#13;&#10;    end&#13;&#10;)&#13;&#10;/1000' />
      </column>
