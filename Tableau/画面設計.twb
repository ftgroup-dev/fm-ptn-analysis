  <worksheets>
    <worksheet name='OK① '>
      <table>
        <view>
          <datasources>
            <datasource caption='実績集計テーブル' name='sqlproxy.0yym43i15hy5lu13mg7ex15c05lg' />
          </datasources>
          <datasource-dependencies datasource='sqlproxy.0yym43i15hy5lu13mg7ex15c05lg'>
            <column caption='達成率バー' datatype='real' name='[Calculation_124623073162207232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='min(1.2)' />
            </column>
            <column aggregation='Sum' caption='♯稼働日' datatype='real' default-type='ordinal' layered='true' name='[Calculation_164381429429039109]' pivot='key' role='measure' type='ordinal' user-datatype='real' visual-totals='Default'>
              <calculation class='tableau' formula='{ FIXED  [年月] : max(if [年月] = [Calculation_164381429429248006] then [稼働日]&#13;&#10;else [営業日日数] end) }' />
            </column>
            <column aggregation='Count' caption='年月_稼働日' datatype='string' default-type='nominal' layered='true' name='[Calculation_164381429429248006]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default'>
              <calculation class='tableau' formula='str(year([本日])) +&#13;&#10;right((&apos;00&apos; + str(month([本日]))),2)' />
            </column>
            <column caption='&apos;表示&apos;' datatype='string' name='[Calculation_626563339820171270]' role='dimension' type='nominal' user:unnamed='OK① '>
              <calculation class='tableau' formula='&apos;表示&apos;' />
            </column>
            <column aggregation='Sum' caption='key' datatype='integer' name='[Calculation_6805431644322123776]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if isnull([委託取次店法人名]) then 0 else 1 end' />
            </column>
            <column caption='進捗率カラーレベル_OK' datatype='string' name='[Calculation_6805431644334862361]' role='measure' type='nominal'>
              <calculation class='tableau' formula='if [進捗率_売上 (コピー)_6805431644325429255] &lt; 0.8 then &apos;未達&apos;&#10;elseif [進捗率_売上 (コピー)_6805431644325429255] &lt; 1 then &apos;80%以上&apos;&#10;else &apos;達成&apos; end' />
            </column>
            <column caption='集計対象月' datatype='date' default-format='*yyyy/mm' name='[Calculation_6894377737339797504]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='date(left([年月],4)+&quot;-&quot;+right([年月],2)+&quot;-01&quot;)' />
            </column>
            <column caption='&quot;全体集計&quot;' datatype='string' name='[Calculation_6894377737341665284]' role='dimension' type='nominal' user:unnamed='売上①'>
              <calculation class='tableau' formula='&quot;全体集計&quot;' />
            </column>
            <column caption='キャンセル_撤去_flag' datatype='integer' name='[Calculation_770115577802661889]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if NOT ISNULL([キャンセル日]) then 1&#13;&#10;elseif NOT ISNULL([撤去日]) then 1&#13;&#10;else 0 end' />
            </column>
            <column aggregation='Sum' caption='Ok実績' datatype='real' default-type='quantitative' layered='true' name='[OK実績]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[OK日]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column aggregation='Sum' caption='Ok目標' datatype='real' default-type='quantitative' layered='true' name='[OK目標]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column-instance column='[Calculation_6894377737339797504]' derivation='MY' name='[my:Calculation_6894377737339797504:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_626563339820171270]' derivation='None' name='[none:Calculation_626563339820171270:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6805431644322123776]' derivation='None' name='[none:Calculation_6805431644322123776:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_6894377737341665284]' derivation='None' name='[none:Calculation_6894377737341665284:nk]' pivot='key' type='nominal' />
            <column-instance column='[タグ01]' derivation='None' name='[none:タグ01:nk]' pivot='key' type='nominal' />
            <column-instance column='[タグ02]' derivation='None' name='[none:タグ02:nk]' pivot='key' type='nominal' />
            <column-instance column='[タグ03]' derivation='None' name='[none:タグ03:nk]' pivot='key' type='nominal' />
            <column-instance column='[委託取次店名]' derivation='None' name='[none:委託取次店名:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_124623073162207232]' derivation='User' name='[usr:Calculation_124623073162207232:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6805431644334862361]' derivation='User' name='[usr:Calculation_6805431644334862361:nk]' pivot='key' type='nominal' />
            <column-instance column='[件数 (コピー)_676384412771102720]' derivation='User' name='[usr:件数 (コピー)_676384412771102720:qk]' pivot='key' type='quantitative' />
            <column-instance column='[実績_売上 (コピー)_6805431644325277702]' derivation='User' name='[usr:実績_売上 (コピー)_6805431644325277702:qk]' pivot='key' type='quantitative' />
            <column-instance column='[残数 (コピー)_6805431644325027843]' derivation='User' name='[usr:残数 (コピー)_6805431644325027843:qk]' pivot='key' type='quantitative' />
            <column-instance column='[目標 (コピー)_6805431644325064708]' derivation='User' name='[usr:目標 (コピー)_6805431644325064708:qk]' pivot='key' type='quantitative' />
            <column-instance column='[進捗率_売上 (コピー)_6805431644325429255]' derivation='User' name='[usr:進捗率_売上 (コピー)_6805431644325429255:qk]' pivot='key' type='quantitative' />
            <column-instance column='[達成率_売上 (コピー)_6805431644325511176]' derivation='User' name='[usr:達成率_売上 (コピー)_6805431644325511176:qk]' pivot='key' type='quantitative' />
            <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[キャンセル日]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[タグ01]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[タグ02]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[タグ03]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[主キー]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column caption='件数_OK' datatype='integer' name='[件数 (コピー)_676384412771102720]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count(if [OK実績] &gt;= 0 and [選択した年月_OK (コピー)_888616550506205184] = 1 and [Calculation_770115577802661889] = 0 then [主キー] else null end)' />
            </column>
            <column aggregation='Sum' datatype='real' default-type='ordinal' layered='true' name='[営業日日数]' pivot='key' role='measure' type='ordinal' user-datatype='real' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[委託取次店名]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[委託取次店法人名]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column caption='実績_OK' datatype='real' name='[実績_売上 (コピー)_6805431644325277702]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum(&#13;&#10;    if [選択した年月_OK (コピー)_888616550506205184] = 1&#13;&#10;       and NOT ISNULL([OK日]) &#13;&#10;       and [Calculation_770115577802661889] = 0 &#13;&#10;    then [OK実績]&#13;&#10;    else 0 &#13;&#10;    end&#13;&#10;)&#13;&#10;/1000' />
            </column>
            <column aggregation='Count' datatype='string' default-type='nominal' layered='true' name='[年月]' pivot='key' role='dimension' type='nominal' user-datatype='string' visual-totals='Default' />
            <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[撤去日]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column aggregation='Year' datatype='date' default-type='ordinal' layered='true' name='[本日]' pivot='key' role='dimension' type='ordinal' user-datatype='date' visual-totals='Default' />
            <column caption='残数_OK' datatype='real' name='[残数 (コピー)_6805431644325027843]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [目標 (コピー)_6805431644325064708] &gt;0 then [目標 (コピー)_6805431644325064708] - [実績_売上 (コピー)_6805431644325277702]&#13;&#10;else 0 end' />
            </column>
            <column caption='目標_OK' datatype='real' name='[目標 (コピー)_6805431644325064708]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ifnull(SUM([OK目標]),0)' />
            </column>
            <column aggregation='Sum' datatype='real' default-type='quantitative' layered='true' name='[稼働日]' pivot='key' role='measure' type='quantitative' user-datatype='real' visual-totals='Default' />
            <column caption='進捗率_OK' datatype='real' default-format='p0%' name='[進捗率_売上 (コピー)_6805431644325429255]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(&#13;&#10;    ([実績_売上 (コピー)_6805431644325277702] / sum([Calculation_164381429429039109]))&#13;&#10;    /&#13;&#10;    ([目標 (コピー)_6805431644325064708] / sum([営業日日数]))&#13;&#10;)' />
            </column>
            <column caption='達成率_OK' datatype='real' default-format='p0%' name='[達成率_売上 (コピー)_6805431644325511176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn(&#13;&#10;if [目標 (コピー)_6805431644325064708] &gt; 0 then [実績_売上 (コピー)_6805431644325277702] / [目標 (コピー)_6805431644325064708]&#13;&#10;else 0 end&#13;&#10;)' />
            </column>
            <column aggregation='Sum' caption='選択した年月_年月' datatype='integer' name='[選択した年月_OK (コピー)_888616550506205184]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_6894377737339797504] = DATETRUNC(&apos;month&apos;, DATEPARSE(&apos;yyyyMM&apos;, [年月])) THEN 1 ELSE 0 END' />
            </column>
          </datasource-dependencies>
