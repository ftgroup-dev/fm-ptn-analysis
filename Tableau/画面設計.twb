        <calculation class='tableau' formula='zn(&#13;&#10;    ([実績_売上 (コピー)_6805431644325277702] / sum([Calculation_164381429429039109]))&#13;&#10;    /&#13;&#10;    ([目標 (コピー)_6805431644325064708] / sum([営業日日数]))&#13;&#10;)' />
      </column>
      <column caption='進捗率カラーレベル_売上' datatype='string' name='[進捗率カラーレベル_OK (コピー)_6805431644335984666]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_807551733275500548] &lt; 0.8 then &apos;未達&apos;&#10;elseif [Calculation_807551733275500548] &lt; 1 then &apos;80%以上&apos;&#10;else &apos;達成&apos; end' />
