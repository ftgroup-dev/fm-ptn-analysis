      <column aggregation='Sum' caption='選択した年月_OK' datatype='integer' name='[選択した年月_売上 (コピー)_6805431644325167109]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Calculation_6894377737339797504] = DATE(DATETRUNC(&apos;month&apos;,[OK日])) then 1 else 0 end' />
