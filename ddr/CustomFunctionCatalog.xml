			<Chunk type="NoRef"> ( ym; 1 ; 4 ) ) ;
    m = </Chunk>
			<Chunk type="FunctionRef">Int</Chunk>
			<Chunk type="NoRef"> ( </Chunk>
			<Chunk type="FunctionRef">Middle</Chunk>
			<Chunk type="NoRef"> ( ym; 5 ; 2 ) ) - 1
] ;
    </Chunk>
