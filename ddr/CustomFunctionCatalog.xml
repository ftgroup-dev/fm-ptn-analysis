	<CustomFunction id="1" functionArity="3" visible="True" parameters="DateStart;DateEnd;HolidayList" name="WorkingDays">
		<Calculation><![CDATA[/*
WorkingDays ( DateStart ; DateEnd ; HolidayList )

returns the number of working days between the two dates.
No weekend days nor any day of the HolidayList
*/

Case(
DateStart > DateEnd ; "" ;
Let ( 
$counter = $counter + ( Mod ( DateStart - 1  ; 7 ) < 5 and IsEmpty ( FilterValues ( DateStart ; HolidayList ) ) ) ;
Case(
DateStart = DateEnd ; $counter & Let( $counter = "" ; "" ) ;
WorkingDays ( DateStart + 1 ; DateEnd ; HolidayList )
)
)
)]]></Calculation>
		<DisplayCalculation>
			<Chunk type="NoRef">/*
WorkingDays ( DateStart ; DateEnd ; HolidayList )

returns the number of working days between the two dates.
No weekend days nor any day of the HolidayList
*/

</Chunk>
			<Chunk type="FunctionRef">Case</Chunk>
			<Chunk type="NoRef">(
DateStart &gt; DateEnd ; &quot;&quot; ;
</Chunk>
			<Chunk type="FunctionRef">Let</Chunk>
			<Chunk type="NoRef"> ( 
$counter = $counter + ( </Chunk>
			<Chunk type="FunctionRef">Mod</Chunk>
			<Chunk type="NoRef"> ( DateStart - 1  ; 7 ) &lt; 5 </Chunk>
			<Chunk type="FunctionRef">and</Chunk>
			<Chunk type="NoRef"> </Chunk>
			<Chunk type="FunctionRef">IsEmpty</Chunk>
			<Chunk type="NoRef"> ( </Chunk>
			<Chunk type="FunctionRef">FilterValues</Chunk>
			<Chunk type="NoRef"> ( DateStart ; HolidayList ) ) ) ;
</Chunk>
			<Chunk type="FunctionRef">Case</Chunk>
			<Chunk type="NoRef">(
DateStart = DateEnd ; $counter &amp; </Chunk>
			<Chunk type="FunctionRef">Let</Chunk>
			<Chunk type="NoRef">( $counter = &quot;&quot; ; &quot;&quot; ) ;
</Chunk>
			<Chunk type="CustomFunctionRef">WorkingDays</Chunk>
			<Chunk type="NoRef"> ( DateStart + 1 ; DateEnd ; HolidayList )
)
)
)</Chunk>
		</DisplayCalculation>
	</CustomFunction>
	<CustomFunction id="2" functionArity="3" visible="True" parameters="日時;形式;型" name="cfTimestamp">
		<Calculation><![CDATA[/* *********************************************************************************** */
/*									*/
/* [ タイムスタンプ] [形式] [型] を受取り、タイムスタンプを指定の形式と型に変換して返す	*/
/*									*/
/* ----------------------------------------------------------------------------------- */
/*									*/
/* 第１引数：	日時							*/
/* 		タイムスタンプで受け取る					*/
/*									*/
/* 第２引数：	形式　※未指定の場合は①					*/
/*		例）"yyyy/mm/dd hh:MM:ss"　※①			*/
/*		        "yyyy/mm/dd hh:MM"				*/
/*		        "yyyy/m/d h:MM"					*/
/*		        "yyyy-mm-dd hh:MM:ss"				*/
/*		        "yyyymmddhhMMss"					*/
/*									*/
/*									*/
/*									*/
/* 第３数：	形式　※未指定の場合は[形式]に合う方			*/
/*		・テキスト							*/
/*		・タイムスタンプ						*/
/*									*/
/* *********************************************************************************** */



Let(

[

 v$y = Year( 日時 );
 v$m = Month( 日時 );
 v$d = Day( 日時 );
 v$h = Hour( 日時 );
 v$mi = Minute( 日時 );
 v$s = Seconds( 日時 );

 v$format = If( not IsEmpty( 形式 ); 形式; "yyyy/mm/dd hh:MM:ss" );

 v$result =
 Substitute( 
	v$format;
	[ "yyyy"; v$y ];
	[ "yy"; Right( v$y; 2 ) ];
	[ "mm"; Right( "0" & v$m; 2 ) ];
	[ "m"; v$m ];
	[ "dd"; Right( "0" &  v$d; 2 ) ];
	[ "d"; v$d ];
	[ "hh"; Right( "0" & v$h; 2 ) ];
	[ "h"; v$h ];
	[ "MM"; Right( "0" & v$mi; 2 ) ];
	[ "M"; v$mi ];
	[ "ss"; Right( "0" & v$s; 2 ) ];
	[ "s"; v$s ]
 );

 v$type =  Case( 
		not IsEmpty( 型 ); 型;
		GetAsTimestamp( v$result ) ≠ "?"; "タイムスタンプ";
		"テキスト"
 	   );

 v$return = Case(
		IsEmpty( 日時 ); "";
		v$type = "テキスト"; GetAsText( v$result );
		v$type = "タイムスタンプ"; GetAsTimestamp ( v$result );
		v$result	//テキスト型になる
	    )

];

v$return

)]]></Calculation>
		<DisplayCalculation>
			<Chunk type="NoRef">/* *********************************************************************************** */
/*									*/
/* [ タイムスタンプ] [形式] [型] を受取り、タイムスタンプを指定の形式と型に変換して返す	*/
/*									*/
/* ----------------------------------------------------------------------------------- */
/*									*/
/* 第１引数：	日時							*/
