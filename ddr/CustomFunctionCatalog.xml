			<Chunk type="FunctionRef">Day</Chunk>
			<Chunk type="NoRef">( 日時 );
 v$h = </Chunk>
			<Chunk type="FunctionRef">Hour</Chunk>
			<Chunk type="NoRef">( 日時 );
 v$mi = </Chunk>
			<Chunk type="FunctionRef">Minute</Chunk>
			<Chunk type="NoRef">( 日時 );
 v$s = </Chunk>
			<Chunk type="FunctionRef">Seconds</Chunk>
			<Chunk type="NoRef">( 日時 );

 v$format = </Chunk>
			<Chunk type="FunctionRef">If</Chunk>
			<Chunk type="NoRef">( </Chunk>
			<Chunk type="FunctionRef">not</Chunk>
			<Chunk type="NoRef"> </Chunk>
			<Chunk type="FunctionRef">IsEmpty</Chunk>
			<Chunk type="NoRef">( 形式 ); 形式; &quot;yyyy/mm/dd hh:MM:ss&quot; );

 v$result =
 </Chunk>
			<Chunk type="FunctionRef">Substitute</Chunk>
			<Chunk type="NoRef">( 
	v$format;
	[ &quot;yyyy&quot;; v$y ];
	[ &quot;yy&quot;; </Chunk>
			<Chunk type="FunctionRef">Right</Chunk>
			<Chunk type="NoRef">( v$y; 2 ) ];
	[ &quot;mm&quot;; </Chunk>
			<Chunk type="FunctionRef">Right</Chunk>
			<Chunk type="NoRef">( &quot;0&quot; &amp; v$m; 2 ) ];
	[ &quot;m&quot;; v$m ];
	[ &quot;dd&quot;; </Chunk>
			<Chunk type="FunctionRef">Right</Chunk>
			<Chunk type="NoRef">( &quot;0&quot; &amp;  v$d; 2 ) ];
	[ &quot;d&quot;; v$d ];
	[ &quot;hh&quot;; </Chunk>
			<Chunk type="FunctionRef">Right</Chunk>
			<Chunk type="NoRef">( &quot;0&quot; &amp; v$h; 2 ) ];
	[ &quot;h&quot;; v$h ];
	[ &quot;MM&quot;; </Chunk>
			<Chunk type="FunctionRef">Right</Chunk>
			<Chunk type="NoRef">( &quot;0&quot; &amp; v$mi; 2 ) ];
	[ &quot;M&quot;; v$mi ];
	[ &quot;ss&quot;; </Chunk>
			<Chunk type="FunctionRef">Right</Chunk>
			<Chunk type="NoRef">( &quot;0&quot; &amp; v$s; 2 ) ];
	[ &quot;s&quot;; v$s ]
 );

 v$type =  </Chunk>
			<Chunk type="FunctionRef">Case</Chunk>
			<Chunk type="NoRef">( 
		</Chunk>
			<Chunk type="FunctionRef">not</Chunk>
