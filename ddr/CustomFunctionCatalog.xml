		&quot;テキスト&quot;
 	   );

 v$return = </Chunk>
			<Chunk type="FunctionRef">Case</Chunk>
			<Chunk type="NoRef">(
		</Chunk>
			<Chunk type="FunctionRef">IsEmpty</Chunk>
			<Chunk type="NoRef">( 日時 ); &quot;&quot;;
		v$type = &quot;テキスト&quot;; </Chunk>
			<Chunk type="FunctionRef">GetAsText</Chunk>
			<Chunk type="NoRef">( v$result );
		v$type = &quot;タイムスタンプ&quot;; </Chunk>
			<Chunk type="FunctionRef">GetAsTimestamp</Chunk>
			<Chunk type="NoRef"> ( v$result );
		v$result	</Chunk>
