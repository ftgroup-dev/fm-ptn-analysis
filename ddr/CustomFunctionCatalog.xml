	<CustomFunction id="9" functionArity="1" visible="True" parameters="num" name="FormatPrice">
		<Calculation><![CDATA[Let (
[
    _num = Int ( num ) ;
    _text = Abs ( _num ) & "" ;
    _len = Length ( _text )
] ;

Let ( _result =
    If ( _len > 3 ;
        FormatPrice ( Left ( _text ; _len - 3 ) ) & "," & Right ( _text ; 3 ) ;
        _text
    )
 ;

If ( _num < 0 ; "-" & _result ; _result )
)
)]]></Calculation>
		<DisplayCalculation>
			<Chunk type="FunctionRef">Let</Chunk>
			<Chunk type="NoRef"> (
[
    _num = </Chunk>
			<Chunk type="FunctionRef">Int</Chunk>
			<Chunk type="NoRef"> ( num ) ;
    _text = </Chunk>
			<Chunk type="FunctionRef">Abs</Chunk>
			<Chunk type="NoRef"> ( _num ) &amp; &quot;&quot; ;
    _len = </Chunk>
			<Chunk type="FunctionRef">Length</Chunk>
			<Chunk type="NoRef"> ( _text )
] ;

</Chunk>
			<Chunk type="FunctionRef">Let</Chunk>
			<Chunk type="NoRef"> ( _result =
    </Chunk>
			<Chunk type="FunctionRef">If</Chunk>
			<Chunk type="NoRef"> ( _len &gt; 3 ;
        </Chunk>
			<Chunk type="CustomFunctionRef">FormatPrice</Chunk>
			<Chunk type="NoRef"> ( </Chunk>
			<Chunk type="FunctionRef">Left</Chunk>
			<Chunk type="NoRef"> ( _text ; _len - 3 ) ) &amp; &quot;,&quot; &amp; </Chunk>
			<Chunk type="FunctionRef">Right</Chunk>
			<Chunk type="NoRef"> ( _text ; 3 ) ;
        _text
    )
 ;

</Chunk>
			<Chunk type="FunctionRef">If</Chunk>
			<Chunk type="NoRef"> ( _num &lt; 0 ; &quot;-&quot; &amp; _result ; _result )
)
)</Chunk>
