	<CustomFunction id="7" functionArity="1" visible="True" parameters="ym" name="GetBeforeYYYYMM">
		<Calculation><![CDATA[Let ( [
    y = Int ( Middle ( ym; 1 ; 4 ) ) ;
    m = Int ( Middle ( ym; 5 ; 2 ) ) - 1
] ;
    Case (
        m = 0 ;
        (y - 1) * 100 + 12 ;
        y * 100 + m
    )
)]]></Calculation>
